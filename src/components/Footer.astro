---
import { business } from "../config";
---

<footer class="footer">
  <div class="container footer-top">
    <div>
      <a class="footer-brand" href="/">
        Moxin Sterling
        <br />
        <span>Advisory</span>
      </a>
      <p>
        Accountancy with perspective.
        <br />
        Practical accounting support.
      </p>
    </div>
    <div>
      <h2>Start a conversation</h2>
      <a class="email" href={`mailto:${business.email}`}>
        {business.email}
      </a>
      <p><a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a><br /><a href={`tel:${business.phoneLink}`}>{business.phone}</a><br />{business.address}</p>
    </div>
    <div>
      <h2>Explore</h2>
      <a href="/services/">Services</a>
      <a href="/pricing/">Pricing</a>
      <a href="/who-we-help/">Who we help</a>
      <a href="/about/">About the firm</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>
      © {new Date().getFullYear()} {business.name}
    </span>
    <div>
      <a href="/privacy/">Website privacy</a>
      <a href="/my-money-privacy/">My Money app privacy</a>
    </div>
  </div>
</footer>
