---
import { socialLinks } from '../config';
---
<nav class="social-links" aria-label="Follow Moxin Sterling Advisory on social media">
  {socialLinks.map(link => <a class="social-button" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} (opens in a new tab)`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      {link.label === 'Facebook'
        ? <path d="M14 21v-8h3l.5-4H14V7c0-1.1.3-2 2-2h2V1.4C17.6 1.3 16.4 1 15 1c-3 0-5 1.8-5 5v3H7v4h3v8z" />
        : <><path d="M4 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4M2 9h4v13H2zM9 9h4v1.8c.7-1.3 2-2.1 3.8-2.1 4.1 0 5.2 2.4 5.2 6V22h-4v-6.5c0-1.8-.4-3.3-2.4-3.3-2.1 0-2.6 1.7-2.6 3.5V22H9z" /></>}
    </svg>
    <span>{link.label}</span>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg>
  </a>)}
</nav>
<style>
  .social-links { display: flex; flex-wrap: wrap; gap: 10px; margin-block: 20px; }
  .social-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 10px 14px; border: 1px solid #b58a42; color: #08233f; background: #f7f3eb; text-decoration: none; font-size: 12px; font-weight: 500; border-radius: 3px; }
  .social-button:hover { background: #eee3d0; }
  .social-button svg { flex-shrink: 0; }
  :global(.footer) .social-button { color: #f7f3eb; background: transparent; border-color: #bda16e; }
  :global(.footer) .social-button:hover { background: #17344e; }
</style>
