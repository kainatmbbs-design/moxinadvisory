---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business, site } from "../config";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {business.displayName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={
        !site.indexing || noindex ? "noindex, nofollow" : "index, follow"
      }
    />
    <meta name="theme-color" content="#30223F" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={`${title} | ${business.displayName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/moxin-logo.png", site.origin).href}
    />
    <meta
      property="og:image:alt"
      content="Moxin Sterling Advisory official logo"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: business.name,
        url: site.origin,
        email: business.email,
        telephone: business.phoneLink,
        address: { "@type": "PostalAddress", streetAddress: "15 Pen Castell", addressLocality: "Bangor", postalCode: "LL57 1NX", addressCountry: "GB" },
        founder: { "@type": "Person", name: business.founder },
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <a class="whatsapp-float" href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Chat with Moxin Sterling Advisory on WhatsApp (opens in a new tab)">
      <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/><path d="M8 7.5c-.8.6-.5 2 .4 3.5s2.5 3.1 4.1 3.8c1.5.6 2.8.5 3.3-.5l.4-1-2.6-1.3-.9 1c-1.3-.6-2.3-1.6-2.9-2.9l.8-.8-1.3-2.5Z"/></svg>
      <span>Chat on WhatsApp</span>
    </a>
  </body>
</html>
