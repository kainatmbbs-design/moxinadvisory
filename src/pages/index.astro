---
import ClientReviews from '../components/ClientReviews.astro';
import BrandImage from '../components/BrandImage.astro';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Invitation from '../components/Invitation.astro';
import { services, business } from '../config';
const iconPaths = ['M4 4h16v16H4zM8 9h8M8 13h8M8 17h5', 'M6 18 18 6M8 8h.01M16 16h.01', 'M4 8h16M4 12h16M4 16h10', 'M6 3h12v18H6zM9 7h6M9 11h6M9 15h2', 'M16 5c-6-3-8 2-6 7v5l-3 2h11M7 12h9', 'M4 19h16M6 15l4-4 4 2 5-8M15 5h4v4'];
const questions = [
 ['What accounting support can you help with?', 'We support bookkeeping, VAT returns, payroll, Self Assessment, annual accounts, Corporation Tax and management reporting. We will agree a scope that fits your circumstances.'],
 ['Can I move from another accountant?', 'Yes. We can discuss your needs and agree a handover process, including what information is required from your previous accountant.'],
 ['Do you work with businesses outside Bangor?', 'Yes. We can work remotely with businesses across the UK, with a working routine and information-sharing process agreed with you.'],
 ['How are your fees agreed?', 'Fees depend on your business, records and the services you need. We discuss the scope and quote before work starts.'],
];
---
<Layout title="Accountants in Bangor | Small business accounting & tax" description="Moxin Sterling Advisory provides personal accounting, bookkeeping, VAT, payroll and tax support from Bangor for UK small businesses and contractors.">
 <section class="new-hero"><div class="container hero-grid">
  <div class="hero-copy"><p class="eyebrow">MOXIN STERLING ADVISORY · ACCOUNTING & TAX</p><h1>Clearer numbers.<br /><em>Brighter possibilities.</em></h1><p class="hero-lead">Personal accounting, tax and business support to help you take your next step with confidence.</p><div class="actions"><Button href="/contact/">Book a consultation</Button><a class="hero-phone" href={`tel:${business.phoneLink}`}>Call {business.phone} <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14" /></svg></a></div><div class="hero-assurance"><span>Personal service</span><span>Clear advice</span><span>Agreed fees</span></div></div>
  <div class="brand-scene"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="scene-grid"></div><div class="scene-top">A PARTNER IN YOUR PROGRESS <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14" /></svg></div><BrandImage hero /><div class="scene-caption">Your business.<br /><em>A fresh perspective.</em></div><div class="scene-bottom">ACCOUNTING <span>·</span> TAX <span>·</span> ADVISORY</div></div>
 </div></section>
 <section class="section container"><div class="section-head"><div><p class="eyebrow">EXPERTISE THAT WORKS FOR YOU</p><h2>Your accounting.<br /><em>All in one place.</em></h2></div><p>From keeping your books in order to understanding what comes next, we bring practical support to every stage of your business.</p></div><div class="new-services">{services.map((service,i)=><a class="new-service" href={`/services/${service.slug}/`}><div class="service-top"><span class="service-symbol" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[i]} /></svg></span></div><h3>{service.title}</h3><p>{service.description}</p><span class="service-more">Explore service <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14" /></svg></span></a>)}</div></section>
 <section class="section container"><div class="section-head"><div><p class="eyebrow">WHO WE WORK WITH</p><h2>For the people<br /><em>building something.</em></h2></div><p>Working independently, running a company or taking your first step: we help you find a clearer way through your accounting.</p></div><div class="client-cards">{[['Sole traders','Spend more time on your work, with support for your records and Self Assessment.'],['Limited companies','Bring your bookkeeping, payroll and company reporting together.'],['Contractors & start-ups','Build an organised foundation and understand your next accounting steps.']].map(([title,copy])=><article><span class="client-index">YOUR BUSINESS</span><h3>{title}</h3><p>{copy}</p><a href="/who-we-help/">Find your support <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14" /></svg></a></article>)}</div></section>
 <section class="faq-section"><div class="container split"><div><p class="eyebrow">GOOD QUESTIONS. CLEAR ANSWERS.</p><h2>A little clarity<br /><em>before we begin.</em></h2><p>Something else on your mind?<br /><a href="/contact/">We would be happy to talk.</a></p></div><div class="faq-list" id="faqs">{questions.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
 <section class="section container perspective-section"><div class="section-head"><div><p class="eyebrow">A LITTLE PERSPECTIVE</p><h2>Make room for<br /><em>your next good idea.</em></h2></div><p>A few useful starting points for conversations about your business finances.</p></div><div class="perspective-grid"><a href="/services/bookkeeping/"><span class="perspective-label">THE EVERYDAY ESSENTIALS</span><div class="perspective-art art-records" aria-hidden="true"><span></span><span></span><span></span></div><h3>Better records.<br />A clearer picture.</h3><p>Explore how organised bookkeeping can help you understand where your business stands.</p><span class="perspective-link">Explore bookkeeping <span aria-hidden="true">→</span></span></a><a href="/services/management-accounts-cash-flow/"><span class="perspective-label">LOOKING AHEAD</span><div class="perspective-art art-growth" aria-hidden="true"><span></span><span></span><span></span><span></span></div><h3>Give your next move<br />some perspective.</h3><p>Start a conversation about management reports, budgets and cash-flow planning.</p><span class="perspective-link">Explore business reporting <span aria-hidden="true">→</span></span></a><a href="/services/vat/"><span class="perspective-label">MAKING SENSE OF TAX</span><div class="perspective-art art-tax" aria-hidden="true">%</div><h3>Less head-scratching.<br />More understanding.</h3><p>Discuss the records and practical support you need for your VAT returns.</p><span class="perspective-link">Explore VAT support <span aria-hidden="true">→</span></span></a></div></section>
 <section class="pricing-preview container" aria-labelledby="pricing-preview-heading"><div><p class="eyebrow">STRAIGHTFORWARD STARTING FEES</p><h2 id="pricing-preview-heading">Support that fits your budget.</h2><a class="text-link" href="/pricing/">See prices and what to expect <span aria-hidden="true">↗</span></a></div><a class="pricing-preview-fee" href="/pricing/"><span>Sole trader · from</span><strong>£30<small>/month</small></strong></a><a class="pricing-preview-fee" href="/pricing/"><span>Limited company · from</span><strong>£90<small>/month</small></strong></a></section>
 <ClientReviews />
 <section class="home-contact"><div class="container home-contact-grid"><div class="location-panel"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><p class="eyebrow">LOCAL KNOWLEDGE. PERSONAL SUPPORT.</p><h2>Based in Bangor.<br />Here for your business.</h2><address>{business.address}</address><a href="https://www.google.com/maps/search/?api=1&amp;query=15%20Pen%20Castell%2C%20Bangor%2C%20LL57%201NX" target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a></div><div><p class="eyebrow">GET IN TOUCH</p><h2>A conversation can<br /><em>make all the difference.</em></h2><p>Tell us where you are today and where you want to go. We’ll discuss the accounting support that could help.</p><a class="contact-direct" href={`tel:${business.phoneLink}`}>{business.phone}</a><a class="contact-direct" href={`mailto:${business.email}`}>{business.email}</a><a class="text-link" href={business.whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a></div></div></section>
 <Invitation />
</Layout>
