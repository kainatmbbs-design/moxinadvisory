---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="My Money app privacy"
  description="Access the existing published privacy policy for the My Money app. This is separate from the Moxin Sterling Advisory website privacy information."
  noindex
>
  <section class="page-hero container">
    <p class="eyebrow">Separate app information</p>
    <h1>
      My Money
      <br />
      app privacy.
    </h1>
    <p class="lead">
      The My Money app has its own privacy policy, separate from this website.
    </p>
  </section>
  <article class="section container prose">
    <h2>Read the published policy</h2>
    <p>
      <a class="button" href="https://my-money-privacy.boldmole16.chatgpt.site">
        Open My Money privacy policy{" "}
        <span aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M5 19 19 5M5 5h14v14" />
          </svg>
        </span>
      </a>
    </p>
    <p>
      The published policy could not be retrieved during this build. It has not
      been copied or rewritten here. Please use the original policy for the
      app’s disclosures.
    </p>
    <p>
      This page is not a replacement app privacy policy. The original must be
      reviewed and its disclosures preserved before publishing a local copy at
      this address.
    </p>
    <p>
      For information about this website’s enquiry form, see{" "}
      <a href="/privacy/">website privacy</a>.
    </p>
  </article>
</Layout>
