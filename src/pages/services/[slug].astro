---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import Invitation from "../../components/Invitation.astro";
import { services } from "../../config";
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service: s } = Astro.props;
---

<Layout title={s.title} description={s.description}>
  <section class="page-hero container">
    <p class="breadcrumb">
      <a href="/services/">Services</a> / {s.title}
    </p>
    <p class="eyebrow">{s.short}</p>
    <h1>{s.title}</h1>
    <p class="lead">{s.description}</p>
    <Button href={`/contact/?service=${encodeURIComponent(s.title)}`}>
      Request a tailored quote
    </Button>
  </section>
  <section class="section container split">
    <div class="prose">
      <h2 style="margin-top:0">Who this suits</h2>
      <p>{s.audience}</p>
      <h2>What support may include</h2>
      <ul class="content-list">
        {s.includes.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <h2>What you may need to provide</h2>
      <ul class="content-list">
        {s.needs.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p>
        We will agree what is needed and how to share it securely. Please do not
        send sensitive records with your initial enquiry.
      </p>
    </div>
    <aside class="quote-box">
      <p class="eyebrow">Built around your business</p>
      <h2>A scope you understand.</h2>
      <p>
        Tell us about your business, your records and the support you are
        looking for. We will discuss the work and provide a tailored quote
        before you decide.
      </p>
      <p>
        General website information is not individual tax or financial advice.
        Requirements depend on your circumstances and the rules in force.
      </p>
      <a class="text-link" href="/contact/">
        Discuss your business{" "}
        <span aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M5 19 19 5M5 5h14v14" />
          </svg>
        </span>
      </a>
    </aside>
  </section>
  <section class="container section" style="padding-top:0">
    <h2>Questions about {s.title.toLowerCase()}</h2>
    <div class="faq-list">
      <details>
        <summary>{s.faq}</summary>
        <p>{s.answer}</p>
      </details>
      <details>
        <summary>How are fees agreed?</summary>
        <p>
          We consider the work required, the volume and condition of your
          records, and how often you need support. We agree the scope and fee
          before starting. Request a tailored quote.
        </p>
      </details>
      <details>
        <summary>How do I get started?</summary>
        <p>
          Use the contact page to describe your business and the support you
          need. An initial enquiry does not create an accountant-client
          relationship. Work begins only after a separate agreement.
        </p>
      </details>
    </div>
  </section>
  <Invitation />
</Layout>
